{
  "name": "seo-toolbox",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "stack": "node scripts/dev-stack.mjs",
    "dev": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:stack": "docker compose up -d postgres redis && pnpm stack",
    "db:generate": "pnpm --filter db generate",
    "db:validate": "pnpm --filter db validate",
    "db:migrate": "pnpm --filter db migrate",
    "db:migrate:deploy": "pnpm --filter db migrate:deploy",
    "db:push": "pnpm --filter db push",
    "db:studio": "pnpm --filter db studio",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}